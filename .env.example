# --- Gemini ---
GEMINI_API_KEY=
# Code default is gemini-3.6-flash; render.yaml pins gemini-flash-latest. Kept
# configurable because free-tier model availability has changed mid-project.
GEMINI_MODEL=gemini-flash-latest
# Gemini embedding free tier, requested at 768 dims (matches the sqlite-vec
# schema), used for near-dup + related-saves. text-embedding-004 was shut down.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Local call counter and the soft daily ceiling it enforces. In practice the free
# tier stops at ~17-20 calls/day; a real 429 is always the hard stop.
GEMINI_DAILY_LIMIT=20
GEMINI_QUOTA_FILE=gemini_quota.json
# Minimum seconds between Gemini calls, and the per-response output token cap.
MIN_GEMINI_CALL_SPACING_SECONDS=4
GEMINI_MAX_OUTPUT_TOKENS=16384

# --- Notion ---
NOTION_TOKEN=
NOTION_DB_ID=
NOTION_CREATORS_DB_ID=
# Only needed to run scripts/setup_notion.py once, to create the DBs above.
NOTION_PARENT_PAGE_ID=

# --- Fetch / burner account safety ---
BURNER_COOKIES_FILE=./cookies.txt
# Username the burner cookies file belongs to. Compared against REAL_ACCOUNT_GUARD
# at startup — if they match, the app refuses to run any fetch. This is the only
# practical way to check "did I accidentally point this at my real account" without
# hitting the IG API just to find out.
BURNER_ACCOUNT_USERNAME=
REAL_ACCOUNT_GUARD=your_real_ig_username

# --- Obsidian vault sync (local only — see VAULT.md) ---
VAULT_PATH=C:\path\to\YourVault
# Read by scripts/scout.py; point it at the same vault.
OBSIDIAN_VAULT_PATH=C:\path\to\YourVault

# --- App ---
CAPTURE_SECRET=change-me
DB_PATH=./data/reelbrain.db
MAX_FETCHES_PER_DAY=25
MIN_FETCH_SPACING_SECONDS=20
# Port for `python -m app.main` (Render injects its own).
PORT=8000
# Commit a DM'd resource to its save with no confirm step. Deliberately OFF: the
# matcher still picks the wrong reel on 3 of 12 known pairs at "high" confidence
# (see the comment above AUTO_ATTACH_ENABLED in app/main.py).
AUTO_ATTACH_ENABLED=0

# --- Public read-only API (/api/public/*, read by the web/ frontend) ---
# Comma-separated browser origins allowed to call it: local dev + your Pages site.
PUBLIC_CORS_ORIGINS=http://localhost:3000,https://your-username.github.io
PUBLIC_RATE_LIMIT_PER_MINUTE=120
PUBLIC_CACHE_TTL_SECONDS=300

# --- Local worker (scripts/daily_runner.py via Task Scheduler; see WORKER_SETUP.md) ---
# Planning budget of Gemini calls per daily pass, spread across backlog steps.
DAILY_GEMINI_BUDGET=20
# Wall-clock cap for the Ollama-routed steps in one pass, in seconds.
LOCAL_TIME_BUDGET_SECONDS=1800
# Wait before retrying a Gemini 503 during bulk ingest, in seconds.
GEMINI_503_RETRY_DELAY_SECONDS=60
# Spacing between OpenGraph caption scrapes during photo recovery, in seconds.
OG_SCRAPE_SPACING_SECONDS=10
# Local LLM for text-only backfill (no audio or vision). Needs Ollama running.
OLLAMA_HOST=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_LLM_TIMEOUT_SECONDS=120

# --- Bulk import (scripts/bulk_import.py, local only) ---
# Your deployed Render URL — the script POSTs to {REELBRAIN_URL}/capture.
REELBRAIN_URL=https://reelbrain.onrender.com

# --- Cookie-health alerting (see COOKIES.md) ---
# Consecutive cookie-backed auth failures before /health reports "degraded".
COOKIE_HEALTH_THRESHOLD=3
# Optional: a free ntfy.sh topic for a real phone push when cookies expire.
# Pick something unguessable — the topic name is the only access control ntfy has.
# Leave blank to skip; the Notion alert fires regardless.
NTFY_TOPIC=
# Optional fallback for the DAILY DIGEST push specifically (app/digest.py's
# send_daily_ntfy), tried only when ntfy.sh itself fails that call. Added
# 2026-08-28: ntfy.sh has been confirmed rate-limiting requests specifically
# from Render's shared egress IP for this one call site -- every LOCAL
# script's ntfy calls (health_watchdog, pipeline_health, daily_capture_report)
# are confirmed working via real phone screenshots and are untouched by this.
# A Discord webhook URL (Server Settings -> Integrations -> Webhooks -> New
# Webhook -> Copy Webhook URL). Leave blank to skip; ntfy stays the only
# attempt, same as before.
DISCORD_WEBHOOK_URL=

# --- Health watchdog (scripts/health_watchdog.py, local only) ---
# Checks the latest GitHub Actions run of each scheduled workflow. A fine-grained
# token with read-only Actions access to this one repo is enough.
GITHUB_REPO=your-username/reelbrain
GITHUB_TOKEN=
