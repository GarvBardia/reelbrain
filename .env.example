# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Gemini embedding free tier (768-dim), used for near-dup + related-saves (Phase 3).
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Notion ---
NOTION_TOKEN=
NOTION_DB_ID=
NOTION_CREATORS_DB_ID=
# Only needed to run scripts/setup_notion.py once, to create the DBs above.
NOTION_PARENT_PAGE_ID=

# --- Fetch / burner account safety ---
BURNER_COOKIES_FILE=./cookies.txt
# Username the burner cookies file belongs to. Compared against REAL_ACCOUNT_GUARD
# at startup — if they match, the app refuses to run any fetch. This is the only
# practical way to check "did I accidentally point this at my real account" without
# hitting the IG API just to find out.
BURNER_ACCOUNT_USERNAME=
REAL_ACCOUNT_GUARD=your_real_ig_username

# --- Obsidian vault sync (local only — see VAULT.md) ---
VAULT_PATH=C:\Users\garvb\ReelBrainVault

# --- App ---
CAPTURE_SECRET=change-me
DB_PATH=./data/reelbrain.db
MAX_FETCHES_PER_DAY=25
MIN_FETCH_SPACING_SECONDS=20

# --- Bulk import (scripts/bulk_import.py, local only) ---
# Your deployed Render URL — the script POSTs to {REELBRAIN_URL}/capture.
REELBRAIN_URL=https://reelbrain.onrender.com
