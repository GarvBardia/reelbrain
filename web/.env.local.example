# The FastAPI backend (Render). No trailing slash.
NEXT_PUBLIC_API_BASE=https://reelbrain.onrender.com

# --- server-only: never prefixed NEXT_PUBLIC_, never shipped to the browser ---
# Password for the /admin login form.
ADMIN_PASSWORD=choose-a-long-random-passphrase
# The backend's CAPTURE_SECRET. Next.js route handlers attach this server-side
# so the browser never holds it.
ADMIN_API_SECRET=the-same-value-as-CAPTURE_SECRET-on-render
